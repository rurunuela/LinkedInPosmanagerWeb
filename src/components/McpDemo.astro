---
import { Icon } from "astro-icon/components";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const exchanges = [
  {
    prompt: "Qu’est-ce qui est prévu sur LinkedIn cette semaine ?",
    tool: "get_post_stats",
    toolDetail: "2 planifiés · 1 brouillon · 0 en retard",
    answer:
      "Deux posts sont programmés, dont « Retour sur notre nouvelle version » jeudi 8 octobre. Un brouillon attend encore une date : « Idées pour novembre ».",
  },
  {
    prompt:
      "Programme un post mardi à 9 h sur nos premiers retours de bêta, avec le tag Retour d’expérience.",
    tool: "create_post",
    toolDetail: "status: scheduled · 2026-10-06T09:00 · tag: Retour d’expérience",
    answer:
      "C’est fait : le brouillon est programmé mardi 6 octobre à 9 h. LinkedinPostManager le publiera à l’heure prévue, en respectant vos règles d’espacement.",
  },
] as const;
---

<figure class:list={["not-prose min-w-0", className]}>
  <div
    class="rounded-2xl bg-linear-to-br from-blue-100 via-sky-50 to-indigo-100 p-4 ring-1 ring-blue-900/5 ring-inset sm:p-8 dark:from-blue-950/70 dark:via-gray-900 dark:to-indigo-950/70 dark:ring-white/5"
  >
    <div
      class="overflow-hidden rounded-xl border border-gray-200 bg-white text-left shadow-xl dark:border-gray-700 dark:bg-gray-900"
    >
      <div
        class="flex items-center gap-2 border-b border-gray-200 px-4 py-3 dark:border-gray-800"
      >
        <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
        <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
        <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
        <span
          class="ml-3 inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 dark:text-gray-400"
        >
          <Icon name="lucide:plug" class="h-3.5 w-3.5" />
          Assistant connecté · linkedin-post-manager
        </span>
      </div>

      <div class="space-y-5 p-4 text-sm sm:p-6">
        {
          exchanges.map((exchange) => (
            <div class="space-y-3">
              <p class="ml-auto w-fit max-w-[85%] rounded-2xl rounded-br-sm bg-blue-600 px-4 py-2.5 text-white dark:bg-blue-500">
                {exchange.prompt}
              </p>
              <p class="flex w-fit max-w-full flex-wrap items-center gap-x-2 gap-y-0.5 rounded-md border border-gray-200 bg-gray-50 px-3 py-1.5 font-mono text-xs text-gray-600 dark:border-gray-700 dark:bg-gray-950 dark:text-gray-400">
                <Icon
                  name="lucide:wrench"
                  class="h-3.5 w-3.5 shrink-0 text-blue-600 dark:text-blue-400"
                />
                <span class="font-semibold text-gray-900 dark:text-gray-100">
                  {exchange.tool}
                </span>
                <span>{exchange.toolDetail}</span>
              </p>
              <p class="max-w-[90%] rounded-2xl rounded-bl-sm bg-gray-100 px-4 py-2.5 text-gray-800 dark:bg-gray-800 dark:text-gray-200">
                {exchange.answer}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <figcaption class="mt-3 text-center text-xs text-gray-500 dark:text-gray-400">
    Exemple d’échange avec un assistant compatible MCP, comme Claude Desktop.
  </figcaption>
</figure>
