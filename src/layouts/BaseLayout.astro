---
import siteConfig from "@config";
import "nprogress/nprogress.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Comment from "../components/Comments.astro";
import GlobalTooltip from "../components/GlobalTooltip.astro";
import BackToTop from "../components/BackToTop.astro";
import { ClientRouter } from "astro:transitions";
import { baseGraph, breadcrumbList, type Breadcrumb } from "../lib/seo";

interface Props {
  pageTitle: string;
  description?: string;
  showComments?: boolean;
  /** Full <title> override (defaults to "pageTitle - site title") */
  metaTitle?: string;
  /** Social sharing image path, relative to the site root */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  /** Trail after "Accueil", e.g. [{ name: "FAQ", href: "/faq" }] */
  breadcrumbs?: Breadcrumb[];
  /** Extra schema.org nodes merged into the page @graph */
  jsonLd?: Record<string, unknown>[];
}

const {
  pageTitle,
  description = siteConfig.description,
  showComments = false,
  metaTitle = `${pageTitle} - ${siteConfig.title}`,
  image = "/og-image.png",
  imageAlt = "LinkedinPostManager, l’application macOS pour programmer ses posts LinkedIn",
  noindex = false,
  breadcrumbs = [],
  jsonLd = [],
} = Astro.props;

const lang = siteConfig.lang ?? "en";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? siteConfig.url)
  .href;
const imageUrl = new URL(image, Astro.site ?? siteConfig.url).href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    ...baseGraph(),
    ...(breadcrumbs.length > 0 ? [breadcrumbList(breadcrumbs)] : []),
    ...jsonLd,
  ],
};
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{metaTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"}
    />
    <meta name="author" content={siteConfig.publisher.name} />
    <meta name="theme-color" content="#2563eb" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
    <ClientRouter />

    <script is:inline>
      const applyTheme = () => {
        const theme = (() => {
          if (
            typeof localStorage !== "undefined" &&
            localStorage.getItem("theme")
          ) {
            return localStorage.getItem("theme");
          }
          if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
            return "dark";
          }
          return "light";
        })();
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      };

      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>

    <script>
      import NProgress from "nprogress";
      NProgress.configure({ showSpinner: false, speed: 400 });
      document.addEventListener("astro:before-preparation", () => {
        NProgress.start();
      });
      document.addEventListener("astro:page-load", () => {
        NProgress.done();
      });
    </script>
  </head>
  <body>
    <Header transition:persist />

    <main
      class="mx-auto my-8 max-w-5xl rounded-lg bg-white p-5 shadow-sm sm:p-8 lg:p-12 dark:bg-gray-900"
      data-pagefind-body
    >
      <slot />
    </main>

    {
      showComments && (
        <section class="mx-auto my-8 max-w-5xl">
          <Comment />
        </section>
      )
    }

    <BackToTop />
    <Footer transition:persist />
    <GlobalTooltip />
  </body>
</html>
