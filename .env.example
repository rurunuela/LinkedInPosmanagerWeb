# URL publique du Worker Cloudflare qui reçoit les demandes bêta.
# Au choix : le Worker dédié (PUBLIC_BETA_FORM_ENDPOINT, prioritaire) ou le
# Worker de contact Hubo Soft partagé (PUBLIC_CONTACT_FORM_ENDPOINT).
# Le domaine du site doit figurer dans ALLOWED_ORIGINS du Worker utilisé.
# Exemple : https://linkedinpostmanager-beta-mailer.<compte>.workers.dev
PUBLIC_BETA_FORM_ENDPOINT=
PUBLIC_CONTACT_FORM_ENDPOINT=

# Clé de site Cloudflare Turnstile (la clé secrète va dans le Worker)
PUBLIC_TURNSTILE_SITE_KEY=
